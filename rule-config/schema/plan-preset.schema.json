{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifitness.local/schema/plan-preset-v1",
  "title": "System Plan Preset V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "presets"],
  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/preset" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "metadata": { "properties": { "status": { "enum": ["AI_DRAFT", "RETIRED"] } } } } },
      "then": { "properties": { "metadata": { "properties": { "activation": { "properties": { "enabled": { "const": false }, "environments": { "maxItems": 0 } } } } } } }
    },
    {
      "if": { "properties": { "metadata": { "properties": { "status": { "const": "AI_VALIDATED" } } } } },
      "then": { "properties": { "metadata": { "properties": { "activation": { "properties": { "enabled": { "const": true }, "environments": { "items": { "enum": ["local", "test", "staging-experience"] }, "minItems": 1 } } } } } } }
    },
    {
      "if": { "properties": { "metadata": { "properties": { "status": { "const": "PUBLIC_RELEASE_APPROVED" } } } } },
      "then": { "properties": { "metadata": { "properties": { "activation": { "properties": { "enabled": { "const": true }, "environments": { "contains": { "const": "public" } } } } } } } }
    }
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "version", "status", "sourceReferences", "sources", "activation"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "kind": { "const": "SYSTEM_PLAN_PRESET" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "enum": ["AI_DRAFT", "AI_VALIDATED", "PUBLIC_RELEASE_APPROVED", "RETIRED"] },
        "sourceReferences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "activation": { "$ref": "#/$defs/activation" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "usageBoundary", "sourceKind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "title": { "type": "string", "minLength": 2 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "internalSource": { "type": "string", "minLength": 2 },
        "usageBoundary": { "type": "string", "minLength": 8 },
        "sourceKind": {
          "enum": [
            "PEER_REVIEWED_POSITION_STAND",
            "PEER_REVIEWED_CONSENSUS_STATEMENT",
            "PROFESSIONAL_ORGANIZATION_SUMMARY",
            "GOVERNMENT_GUIDELINE",
            "GOVERNMENT_PUBLIC_HEALTH_GUIDANCE",
            "INTERNAL_USER_PLAN"
          ]
        }
      },
      "oneOf": [
        { "required": ["url"], "not": { "required": ["internalSource"] } },
        { "required": ["internalSource"], "not": { "required": ["url"] } }
      ],
      "allOf": [
        {
          "if": { "properties": { "sourceKind": { "const": "INTERNAL_USER_PLAN" } } },
          "then": { "required": ["internalSource"], "not": { "required": ["url"] } },
          "else": { "required": ["url"], "not": { "required": ["internalSource"] } }
        }
      ]
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "environments"],
      "properties": {
        "enabled": { "type": "boolean" },
        "environments": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["local", "test", "staging-experience", "public"] }
        }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "version", "templateCode", "name", "experience", "goal", "weeklyFrequency", "sessionMinutes", "location", "trainingSplit", "contentStatus", "professionalReviewStatus", "availabilityStatus", "sourceIds", "explanationSourceIds", "executionRules", "progressionRules", "days"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "templateCode": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "name": { "type": "string", "minLength": 2 },
        "experience": { "enum": ["BEGINNER", "INTERMEDIATE", "ADVANCED"] },
        "goal": { "enum": ["STRENGTH", "HYPERTROPHY", "FAT_LOSS", "GENERAL_FITNESS"] },
        "weeklyFrequency": { "type": "integer", "minimum": 2, "maximum": 6 },
        "sessionMinutes": { "type": "integer", "minimum": 1 },
        "location": { "enum": ["HOME", "GYM"] },
        "trainingSplit": { "enum": ["FULL_BODY", "UPPER_LOWER", "PUSH_PULL_LEGS", "BODY_PART_FIVE_DAY"] },
        "contentStatus": { "enum": ["AI_DRAFT", "AI_VALIDATED", "PUBLIC_RELEASE_APPROVED", "RETIRED"] },
        "professionalReviewStatus": { "enum": ["PENDING", "APPROVED"] },
        "availabilityStatus": { "enum": ["AVAILABLE", "BLOCKED_CAPABILITY"] },
        "unavailableReason": { "type": "string", "minLength": 8 },
        "introductoryPhase": { "$ref": "#/$defs/introductoryPhase" },
        "movementImpactConstraint": { "enum": ["NO_JUMP"] },
        "reviewRecordId": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
        },
        "explanationSourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
        },
        "executionRules": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "progressionRules": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "days": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/day" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "professionalReviewStatus": { "const": "APPROVED" } } },
          "then": { "required": ["reviewRecordId", "reviewedAt"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["reviewRecordId"] },
                { "required": ["reviewedAt"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "contentStatus": { "const": "PUBLIC_RELEASE_APPROVED" } } },
          "then": { "properties": { "professionalReviewStatus": { "const": "APPROVED" } } }
        },
        {
          "if": { "properties": { "availabilityStatus": { "const": "BLOCKED_CAPABILITY" } } },
          "then": { "required": ["unavailableReason"] },
          "else": { "not": { "required": ["unavailableReason"] } }
        }
      ]
    },
    "introductoryPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weeks", "workSets", "targetRirMin", "targetRirMax", "transitionCondition"],
      "properties": {
        "weeks": { "type": "integer", "minimum": 1, "maximum": 8 },
        "workSets": { "type": "integer", "minimum": 1, "maximum": 6 },
        "targetRirMin": { "type": "integer", "minimum": 0, "maximum": 10 },
        "targetRirMax": { "type": "integer", "minimum": 0, "maximum": 10 },
        "transitionCondition": { "type": "string", "minLength": 8 }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "weekday", "name", "focus", "estimatedMinutes", "warmup", "notes", "exercises"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "weekday": { "enum": ["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY"] },
        "name": { "type": "string", "minLength": 2 },
        "focus": { "type": "string", "minLength": 1 },
        "estimatedMinutes": { "$ref": "#/$defs/estimatedMinutes" },
        "warmup": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/warmupStep" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/exercise" }
        }
      }
    },
    "estimatedMinutes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 }
      }
    },
    "warmupStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction", "prescription"],
      "properties": {
        "instruction": { "type": "string", "minLength": 1 },
        "prescription": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exerciseCode", "workSets", "repRange", "restSeconds", "weightStatus"],
      "dependentRequired": {
        "targetRirMin": ["targetRirMax"],
        "targetRirMax": ["targetRirMin"],
        "executionGroup": ["executionOrder"],
        "executionOrder": ["executionGroup"]
      },
      "properties": {
        "exerciseCode": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "workSets": { "type": "integer", "minimum": 1, "maximum": 6 },
        "repRange": { "$ref": "#/$defs/repRange" },
        "restSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
        "weightStatus": { "enum": ["NEEDS_CALIBRATION", "BODYWEIGHT", "KNOWN"] },
        "targetWeightKg": { "type": "number", "minimum": 0, "multipleOf": 0.01 },
        "targetRirMin": { "type": "integer", "minimum": 0, "maximum": 10 },
        "targetRirMax": { "type": "integer", "minimum": 0, "maximum": 10 },
        "eccentricSeconds": { "type": "integer", "minimum": 1, "maximum": 10 },
        "perSide": { "type": "boolean" },
        "executionGroup": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "executionOrder": { "type": "integer", "minimum": 1, "maximum": 8 },
        "optionalSetRule": { "$ref": "#/$defs/optionalSetRule" },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "repRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 1, "maximum": 30 },
        "max": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "optionalSetRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditionCode", "exclusiveChoiceGroup", "additionalSets"],
      "properties": {
        "conditionCode": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "exclusiveChoiceGroup": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "additionalSets": { "const": 1 }
      }
    }
  }
}
