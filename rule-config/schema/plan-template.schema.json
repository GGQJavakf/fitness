{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifitness.local/schema/plan-template-v1",
  "title": "TemplateVersion V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "templates"],
  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "audience", "sessionsPerWeek", "days"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "name": { "type": "string", "minLength": 2 },
          "audience": { "const": "ADULT_GENERAL_FITNESS_NON_MEDICAL" },
          "sessionsPerWeek": { "type": "integer", "minimum": 2, "maximum": 6 },
          "days": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "name", "exercises"],
              "properties": {
                "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
                "name": { "type": "string", "minLength": 2 },
                "exercises": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["exerciseCode", "order", "workSets", "repRange", "restSeconds", "initialWeightState"],
                    "properties": {
                      "exerciseCode": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
                      "order": { "type": "integer", "minimum": 1, "maximum": 8 },
                      "workSets": { "type": "integer", "minimum": 1, "maximum": 6 },
                      "repRange": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["min", "max"],
                        "properties": {
                          "min": { "type": "integer", "minimum": 1, "maximum": 20 },
                          "max": { "type": "integer", "minimum": 2, "maximum": 30 }
                        }
                      },
                      "restSeconds": { "type": "integer", "minimum": 30, "maximum": 300 },
                      "initialWeightState": { "enum": ["NEEDS_CALIBRATION", "BODYWEIGHT"] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "metadata": { "properties": { "status": { "enum": ["AI_DRAFT", "RETIRED"] } } } } },
      "then": { "properties": { "metadata": { "properties": { "activation": { "properties": { "enabled": { "const": false }, "environments": { "maxItems": 0 } } } } } } }
    },
    {
      "if": { "properties": { "metadata": { "properties": { "status": { "const": "AI_VALIDATED" } } } } },
      "then": { "properties": { "metadata": { "properties": { "activation": { "properties": { "enabled": { "const": true }, "environments": { "items": { "enum": ["local", "test", "staging-experience"] }, "minItems": 1 } } } } } } }
    },
    {
      "if": { "properties": { "metadata": { "properties": { "status": { "const": "PUBLIC_RELEASE_APPROVED" } } } } },
      "then": { "properties": { "metadata": { "properties": { "activation": { "properties": { "enabled": { "const": true }, "environments": { "contains": { "const": "public" } } } } } } } }
    }
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "version", "ruleVersion", "contentVersion", "status", "generatedAt", "promptConstraints", "sourceReferences", "activation", "digestSha256"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "kind": { "const": "PLAN_TEMPLATE" },
        "version": { "const": "1.2.0" },
        "ruleVersion": { "const": "1.2.0" },
        "contentVersion": { "const": "1.2.0" },
        "status": { "enum": ["AI_DRAFT", "AI_VALIDATED", "PUBLIC_RELEASE_APPROVED", "RETIRED"] },
        "generatedAt": { "type": "string", "format": "date-time" },
        "promptConstraints": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 8 } },
        "sourceReferences": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "activation": { "$ref": "#/$defs/activation" },
        "digestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "accessedAt", "usage"],
      "properties": {
        "id": { "type": "string" }, "title": { "type": "string" }, "url": { "type": "string", "format": "uri" },
        "accessedAt": { "type": "string", "format": "date" }, "usage": { "type": "string", "minLength": 8 }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "environments"],
      "properties": {
        "enabled": { "type": "boolean" },
        "environments": { "type": "array", "uniqueItems": true, "items": { "enum": ["local", "test", "staging-experience", "public"] } }
      }
    }
  }
}
