{
  "name": "ai-fitness-miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "AI 健身助手微信小程序",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "taro build --type weapp --watch",
    "generate:api-types": "openapi-typescript ../contract/openapi.yaml -o src/infrastructure/api/schema.generated.ts",
    "check:api-types": "openapi-typescript ../contract/openapi.yaml -o src/infrastructure/api/schema.generated.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/runtime": "7.27.6",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.27.1",
    "@tarojs/cli": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "22.15.32",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "babel-preset-taro": "4.2.1",
    "openapi-typescript": "7.13.0",
    "react-refresh": "0.14.2",
    "sass": "1.101.6",
    "typescript": "5.7.2",
    "vitest": "4.1.10",
    "webpack": "5.91.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "globs": {
      "glob": "13.0.6"
    },
    "webpack-dev-server": "5.2.6",
    "swiper": "12.1.2"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ]
}
