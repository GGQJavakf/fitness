{
  "name": "ai-fitness-miniprogram",
  "version": "0.1.2",
  "private": true,
  "description": "AI 健身助手微信小程序",
  "scripts": {
    "prepare:project-config": "node ../scripts/prepare-wechat-project-config.mjs",
    "build:weapp": "npm run prepare:project-config && node scripts/taro-weapp-build.mjs && node scripts/check-preview-launch-conditions.mjs && node scripts/check-physical-async-boundaries.mjs && node scripts/check-package-size.mjs",
    "build:weapp:device": "node scripts/device-preflight.mjs --build",
    "preflight:device": "node scripts/device-preflight.mjs",
    "preflight:staging": "npm run prepare:project-config && node scripts/release-preflight.mjs --target staging-experience",
    "preflight:release": "npm run prepare:project-config && node scripts/release-preflight.mjs --target public",
    "dev:weapp": "npm run prepare:project-config && node scripts/taro-weapp-build.mjs --watch",
    "generate:api-types": "openapi-typescript ../contract/openapi.yaml -o src/infrastructure/api/schema.generated.ts",
    "generate:content-review-pack": "node scripts/generate-content-review-pack.mjs",
    "check:api-types": "openapi-typescript ../contract/openapi.yaml -o src/infrastructure/api/schema.generated.ts --check",
    "check:content-review-pack": "node scripts/generate-content-review-pack.mjs --check",
    "audit:packaged": "npm audit --omit=dev --audit-level=low --registry=https://registry.npmjs.org",
    "audit:toolchain": "npm audit --audit-level=low --registry=https://registry.npmjs.org",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run audit:packaged && npm run audit:toolchain && npm run check:api-types && npm run typecheck && npm test -- --run && npm run build:weapp"
  },
  "dependencies": {
    "@babel/runtime": "7.27.6",
    "@babel/runtime-corejs3": "7.29.7",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "core-js-pure": "3.49.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@babel/preset-react": "7.27.1",
    "@tarojs/plugin-doctor": "0.0.13",
    "@tarojs/service": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "22.15.32",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/react-test-renderer": "18.3.1",
    "babel-preset-taro": "4.2.1",
    "less": "4.8.1",
    "openapi-typescript": "7.13.0",
    "react-refresh": "0.14.2",
    "react-test-renderer": "18.3.1",
    "sass": "1.101.6",
    "typescript": "5.7.2",
    "vitest": "4.1.10",
    "webpack": "5.109.2"
  },
  "engines": {
    "node": "20 || >=22"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "brace-expansion": "2.1.4",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "nanoid": "3.3.18",
    "vm2": "3.11.6",
    "esbuild@0.21.5": "0.25.12",
    "postcss": "8.5.26",
    "uuid@8.3.2": "11.1.1",
    "@redocly/openapi-core": "1.34.19",
    "adm-zip@0.5.18": "0.6.0",
    "js-yaml": "4.3.1",
    "glob@10.2.6": "10.5.0",
    "serialize-javascript@6.0.2": "7.1.0",
    "webpack": "5.109.2",
    "webpackbar": "7.0.0",
    "webpack-dev-server": "5.2.6",
    "swiper": "12.1.2",
    "less": "$less",
    "html-minifier": "npm:html-minifier-terser@7.2.0"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ]
}
