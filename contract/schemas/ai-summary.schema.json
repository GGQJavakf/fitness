{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifitness.local/schemas/ai-summary-v1.json",
  "title": "AI workout summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "highlights", "issues", "nextActions", "explanation", "safetyNotice"],
  "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 300},
    "highlights": {
      "type": "array",
      "maxItems": 5,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "issues": {
      "type": "array",
      "maxItems": 5,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "nextActions": {
      "type": "array",
      "maxItems": 5,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "explanation": {"type": "string", "minLength": 1, "maxLength": 500},
    "safetyNotice": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 240}
      ]
    }
  }
}
